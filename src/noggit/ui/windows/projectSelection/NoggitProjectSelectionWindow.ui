  <widget class="QWidget" name="centralwidget">
   <property name="styleSheet"><string notr="true">QWidget#centralwidget { color:#e9ecff; border-image:url(:/shadow-world-selector-background) 0 0 0 0 stretch stretch; }
QFrame#outerFrame, QFrame#topBar, QFrame#recentPanel, QFrame#startPanel, QFrame#heroPanel, QFrame#titleCrest { background:transparent; border:none; }
QLabel#panelTitle { color:#e0c891; font-family:"Times New Roman"; font-size:25px; font-weight:600; letter-spacing:1px; background:transparent; }
QLabel#panelOrnament { color:#80a8f2; font-size:14px; background:transparent; }
QListWidget#listView { background:transparent; border:none; outline:0; padding:0; }
QListWidget#listView::item { background:rgba(3,9,29,216); border:1px solid #395b9d; margin:5px 1px; padding:0; }
QListWidget#listView::item:hover { background:rgba(12,33,75,235); border-color:#7daeff; }
QListWidget#listView::item:selected { background:rgba(28,45,99,240); border-color:#b5a5ff; }
QPushButton#actionButton, QPushButton#disabledActionButton { border:9px solid #101e42; border-image:url(:/sw-ui/action-frame) 14 18 14 18 stretch stretch; background:rgba(2,10,33,220); text-align:left; padding-left:34px; color:#f2dfad; font-family:"Times New Roman"; font-size:17px; font-weight:600; }
QPushButton#actionButton:hover { background:rgba(24,55,115,235); color:#ffffff; }
QPushButton#disabledActionButton:disabled { color:#9da2b9; background:rgba(3,8,27,190); }
QPushButton#button_open_project_folder { border:8px solid #101e42; border-image:url(:/sw-ui/action-frame) 14 18 14 18 stretch stretch; background:rgba(2,10,33,220); color:#e8d6a2; font-family:"Times New Roman"; font-size:16px; font-weight:600; }
QPushButton#button_open_project_folder:hover { background:rgba(24,55,115,235); color:white; }
QToolButton#settings_button, QToolButton#changelog_button { background:rgba(2,10,33,170); border:none; color:#b1ceff; font-size:26px; }
QToolButton#settings_button:hover, QToolButton#changelog_button:hover { color:white; background:#234e91; }
QPushButton#button_exit_project { background:rgba(3,12,38,215); color:#e8d6a2; border:1px solid #5379c4; padding:7px 18px; font-family:"Times New Roman"; font-size:14px; }
QPushButton#button_exit_project:hover { background:#234e91; border-color:#aed2ff; color:white; }
QLabel#footerCenter { color:#b7d3ff; background:rgba(2,9,29,225); font-family:"Times New Roman"; font-size:14px; font-weight:700; letter-spacing:1px; padding:4px; border-bottom:1px solid #6289d0; }
</string></property>
