   <property name="styleSheet">
    <string notr="true">QWidget#centralwidget {
 background: qradialgradient(cx:0.50, cy:0.42, radius:0.90, fx:0.50, fy:0.36, stop:0 #1a0a2d, stop:0.38 #0c0715, stop:1 #030207);
 color: #e8dff0;
}
QFrame#outerFrame {
 background: rgba(3, 2, 7, 232);
 border: 2px solid #4f2a6d;
 border-radius: 5px;
}
QFrame#topBar, QFrame#bottomBar {
 background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #0e0916, stop:1 #07040c);
 border: 1px solid #3d244f;
}
QFrame#recentPanel, QFrame#startPanel {
 background: rgba(5, 4, 10, 244);
 border: 2px solid #34203f;
 border-radius: 3px;
}
QFrame#heroPanel {
 background: qradialgradient(cx:0.50, cy:0.47, radius:0.85, fx:0.50, fy:0.45, stop:0 #21103a, stop:0.52 #0b0713, stop:1 #040307);
 border: 1px solid #2e1e3a;
 border-radius: 2px;
}
QLabel#panelTitle {
 color: #cf71ff;
 font-family: "Segoe UI Semibold";
 font-size: 20px;
 font-weight: 600;
 padding: 5px 0 8px 0;
}
QFrame#ornamentLine {
 color: #6b3a86;
 background: #6b3a86;
 max-height: 1px;
 min-height: 1px;
 border: none;
}
QListWidget#listView {
 background: transparent;
 border: none;
 outline: 0;
 padding: 2px;
}
QListWidget#listView::item {
 background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #121019, stop:1 #08070c);
 border: 1px solid #302638;
 border-radius: 3px;
 margin: 4px 1px;
 padding: 4px;
}
QListWidget#listView::item:hover {
 background: #191024;
 border: 1px solid #754295;
}
QListWidget#listView::item:selected {
 background: #241235;
 border: 1px solid #b85ce7;
}
QPushButton#actionButton, QPushButton#disabledActionButton {
 text-align: left;
 padding-left: 24px;
 background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #14101a, stop:1 #09070d);
 color: #d99aff;
 border: 1px solid #523166;
 border-radius: 4px;
 font-family: "Segoe UI Semibold";
 font-size: 16px;
 font-weight: 600;
}
QPushButton#actionButton:hover {
 background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #281638, stop:1 #120a1c);
 border: 1px solid #b65ae6;
 color: #f2d8ff;
}
QPushButton#actionButton:pressed { background: #0e0715; }
QPushButton#disabledActionButton:disabled {
 color: #78647f;
 border-color: #2b2230;
 background: #0a080d;
}
QToolButton#headerTool {
 background: transparent;
 color: #c65af5;
 border: none;
 font-size: 25px;
 padding: 4px;
}
QToolButton#headerTool:hover { color: #f1c9ff; background: #1b1026; border-radius: 4px; }
QPushButton#button_exit_project {
 background: transparent;
 color: #967ba3;
 border: 1px solid #432952;
 border-radius: 3px;
 padding: 5px 12px;
 font-size: 12px;
}
QPushButton#button_exit_project:hover { color: #ffffff; border-color: #b45de0; background: #21122d; }
</string>
