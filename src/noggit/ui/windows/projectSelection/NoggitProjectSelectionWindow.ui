  <widget class="QWidget" name="centralwidget">
   <property name="styleSheet"><string notr="true">QWidget#centralwidget { background:#030207; color:#eee7f4; }
QFrame#outerFrame { background:#040309; border:2px solid #3c224c; }
QFrame#topBar { background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #0d0913,stop:1 #050408); border:1px solid #302038; }
QFrame#recentPanel, QFrame#startPanel { background:#050409; border:1px solid #4a3653; }
QFrame#heroPanel { background:qradialgradient(cx:.5,cy:.46,radius:.82,fx:.5,fy:.43,stop:0 #1b0b2e,stop:.45 #0b0713,stop:1 #030207); border:1px solid #302139; }
QLabel#panelTitle { color:#cb77f2; font-family:"Segoe UI Semibold"; font-size:24px; font-weight:600; padding:10px 0 6px 0; }
QFrame#ornamentLine { background:#5e376d; border:none; min-height:1px; max-height:1px; }
QListWidget#listView { background:transparent; border:none; outline:0; padding:0; }
QListWidget#listView::item { background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #111018,stop:1 #07070b); border:1px solid #403347; margin:5px 0; padding:0; }
QListWidget#listView::item:hover { background:#181021; border-color:#84529a; }
QListWidget#listView::item:selected { background:#241331; border-color:#ba68dd; }
QPushButton#actionButton, QPushButton#disabledActionButton { text-align:left; padding-left:28px; background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #121018,stop:1 #08070c); color:#d392ef; border:1px solid #4a3654; font-family:"Segoe UI Semibold"; font-size:17px; font-weight:600; }
QPushButton#actionButton:hover { background:#1c1028; border-color:#a75dca; color:#f2d9ff; }
QPushButton#disabledActionButton:disabled { color:#76677c; border-color:#2f2833; background:#09080c; }
QToolButton#settings_button, QToolButton#changelog_button { background:transparent; border:none; color:#c76cf0; font-size:24px; }
QToolButton#settings_button:hover, QToolButton#changelog_button:hover { background:#1b1025; }
QPushButton#button_exit_project { background:#0b0810; color:#bdaec5; border:1px solid #493553; padding:6px 18px; }
QPushButton#button_exit_project:hover { color:white; border-color:#a85cca; background:#1d1127; }
QLabel#footerText { color:#a869c2; font-family:"Segoe UI Semibold"; font-size:12px; }
</string></property>
