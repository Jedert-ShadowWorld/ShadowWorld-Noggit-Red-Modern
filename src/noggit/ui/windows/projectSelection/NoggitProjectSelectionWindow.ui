  <widget class="QWidget" name="centralwidget">
   <property name="styleSheet"><string notr="true">QWidget#centralwidget {
 background:qradialgradient(cx:.50,cy:.38,radius:1.05,fx:.50,fy:.35,stop:0 #13091e,stop:.34 #09060f,stop:.72 #030307,stop:1 #010103);
 color:#eee7f4;
}
QFrame#outerFrame {
 background:#020205;
 border:2px solid #25172e;
 border-radius:2px;
}
QFrame#topBar {
 background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #100b16,stop:.48 #08060d,stop:1 #030306);
 border:1px solid #382345;
 border-bottom:2px solid #6e3a82;
}
QFrame#recentPanel, QFrame#startPanel {
 background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #07070b,stop:.5 #030307,stop:1 #020205);
 border:2px solid #2e2135;
 border-radius:3px;
}
QFrame#recentInner, QFrame#startInner {
 background:transparent;
 border:1px solid #5a3666;
 border-radius:2px;
}
QFrame#heroPanel {
 background:qradialgradient(cx:.50,cy:.47,radius:.82,fx:.50,fy:.44,stop:0 #211037,stop:.34 #0f0818,stop:.70 #050409,stop:1 #020205);
 border:2px solid #2f2137;
}
QFrame#heroInner {
 background:qradialgradient(cx:.50,cy:.47,radius:.60,fx:.50,fy:.43,stop:0 rgba(115,48,157,62),stop:.56 rgba(42,17,58,24),stop:1 rgba(0,0,0,0));
 border:1px solid #52305e;
}
QLabel#panelTitle {
 color:#d27bff;
 font-family:"Georgia";
 font-size:25px;
 font-weight:600;
 letter-spacing:1px;
 padding:8px 0 3px 0;
}
QLabel#panelGlyph {
 color:#9e52c2;
 font-size:15px;
 padding:0;
}
QFrame#ornamentLine {
 background:qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 transparent,stop:.18 #493052,stop:.50 #a05cc0,stop:.82 #493052,stop:1 transparent);
 border:none;
 min-height:1px;
 max-height:1px;
}
QListWidget#listView { background:transparent; border:none; outline:0; padding:2px; }
QListWidget#listView::item {
 background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #111016,stop:.52 #09090d,stop:1 #050508);
 border:1px solid #47344d;
 border-radius:2px;
 margin:5px 0;
 padding:0;
}
QListWidget#listView::item:hover { background:#17101f; border-color:#86509a; }
QListWidget#listView::item:selected { background:#21112e; border:1px solid #c16ae3; }
QPushButton#actionButton, QPushButton#disabledActionButton {
 text-align:left;
 padding-left:30px;
 background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #111016,stop:.5 #09080d,stop:1 #050508);
 color:#dca0f7;
 border:1px solid #5a3c64;
 border-radius:3px;
 font-family:"Georgia";
 font-size:16px;
 font-weight:600;
}
QPushButton#actionButton:hover { background:#1a1024; border-color:#bb64df; color:#f4dfff; }
QPushButton#disabledActionButton:disabled { color:#88778e; border-color:#3b303f; background:#08070b; }
QPushButton#button_open_project_folder {
 background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #111017,stop:1 #07070a);
 color:#d394ef;
 border:1px solid #65416f;
 border-radius:3px;
 font-family:"Georgia";
 font-size:16px;
 font-weight:600;
}
QPushButton#button_open_project_folder:hover { background:#1b1124; border-color:#b463d1; color:#f1d8ff; }
QToolButton#settings_button, QToolButton#changelog_button {
 background:transparent; border:none; color:#c96af1; font-size:24px; padding:5px;
}
QToolButton#settings_button:hover, QToolButton#changelog_button:hover { background:#1a1022; border:1px solid #69417a; border-radius:3px; }
QPushButton#button_exit_project {
 background:#09070d; color:#c5b7cb; border:1px solid #4c3556; border-radius:2px; padding:6px 18px;
}
QPushButton#button_exit_project:hover { color:white; border-color:#a95dcc; background:#1c1025; }
QLabel#brandMain { color:#dba6f7; font-family:"Georgia"; font-size:54px; font-weight:600; letter-spacing:5px; }
QLabel#brandSub { color:#e9e0eb; font-family:"Georgia"; font-size:21px; letter-spacing:6px; }
QLabel#heroHeading { color:#cf83ec; font-family:"Georgia"; font-size:24px; font-weight:600; letter-spacing:2px; }
QLabel#heroSubtitle { color:#9d8aa5; font-size:12px; letter-spacing:3px; }
QLabel#footerCenter { color:#bd72d5; font-family:"Georgia"; font-size:13px; letter-spacing:1px; }
</string></property>
