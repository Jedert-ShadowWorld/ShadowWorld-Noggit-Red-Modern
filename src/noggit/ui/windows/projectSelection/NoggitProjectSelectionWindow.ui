 <class>NoggitProjectSelectionWindow</class>
 <widget class="QMainWindow" name="NoggitProjectSelectionWindow">
  <property name="geometry"><rect><x>0</x><y>0</y><width>1600</width><height>900</height></rect></property>
  <property name="minimumSize"><size><width>1360</width><height>760</height></size></property>
  <property name="windowTitle"><string>ShadowWorld Noggit</string></property>
  <property name="windowIcon"><iconset><normalon>:/icon-shadow</normalon></iconset></property>
  <widget class="QWidget" name="centralwidget">
   <property name="styleSheet"><string notr="true">QWidget#centralwidget { background:#020104; color:#eee7f4; }
QFrame#outerFrame { border:10px solid #17121c; border-image:url(:/sw-ui/outer-frame) 42 42 42 42 stretch stretch; background:#030207; }
QFrame#topBar { background:rgba(3,2,7,245); border-bottom:2px solid #34263d; }
QFrame#recentPanel, QFrame#startPanel { border:12px solid #17121c; border-image:url(:/sw-ui/panel-frame) 24 24 24 24 stretch stretch; background:rgba(3,3,7,245); }
QFrame#heroPanel { background:qradialgradient(cx:.5,cy:.48,radius:.82,fx:.5,fy:.45,stop:0 #28103e,stop:.34 #130921,stop:.72 #07040d,stop:1 #020104); border-left:2px solid #2d2135; border-right:2px solid #2d2135; }
QFrame#titleCrest { background-color:transparent; background-image:url(:/sw-ui/title-ornament); background-position:center; background-repeat:no-repeat; border:none; }
QLabel#panelTitle { color:#d57cf6; font-family:"Times New Roman"; font-size:25px; font-weight:600; letter-spacing:1px; background:transparent; }
QLabel#panelOrnament { color:#8a529d; font-size:14px; background:transparent; }
QListWidget#listView { background:transparent; border:none; outline:0; padding:0; }
QListWidget#listView::item { background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 rgba(17,15,23,245),stop:1 rgba(5,5,8,245)); border:1px solid #4d4052; margin:5px 1px; padding:0; }
QListWidget#listView::item:hover { background:#181021; border-color:#8c56a1; }
QListWidget#listView::item:selected { background:#21122f; border-color:#bd6de0; }
QPushButton#actionButton, QPushButton#disabledActionButton { border:9px solid #17121c; border-image:url(:/sw-ui/action-frame) 14 18 14 18 stretch stretch; background:rgba(7,6,10,235); text-align:left; padding-left:34px; color:#d994f5; font-family:"Times New Roman"; font-size:17px; font-weight:600; }
QPushButton#actionButton:hover { background:rgba(30,15,43,235); color:#f2d7ff; }
QPushButton#disabledActionButton:disabled { color:#76677c; background:rgba(7,6,10,220); }
QPushButton#button_open_project_folder { border:8px solid #17121c; border-image:url(:/sw-ui/action-frame) 14 18 14 18 stretch stretch; background:#09070d; color:#d58cf1; font-family:"Times New Roman"; font-size:16px; font-weight:600; }
QPushButton#button_open_project_folder:hover { background:#1b1026; color:#f0d2ff; }
QToolButton#settings_button, QToolButton#changelog_button { background:transparent; border:none; color:#cb76ef; font-size:26px; }
QToolButton#settings_button:hover, QToolButton#changelog_button:hover { color:#f0c7ff; background:#160d20; }
QPushButton#button_exit_project { background:#08060c; color:#ccbcd3; border:1px solid #55415d; padding:7px 18px; font-family:"Times New Roman"; font-size:14px; }
QPushButton#button_exit_project:hover { background:#1a1022; border-color:#a967bd; color:white; }
QLabel#footerCenter { color:#bb73d3; font-family:"Times New Roman"; font-size:15px; letter-spacing:1px; }
</string></property>
