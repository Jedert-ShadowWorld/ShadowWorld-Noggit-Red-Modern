  <widget class="QWidget" name="centralwidget">
   <property name="styleSheet"><string notr="true">QWidget#centralwidget {
 background: qradialgradient(cx:.5,cy:.42,radius:.92,fx:.5,fy:.42,stop:0 #120821,stop:.46 #07040c,stop:1 #020104);
 color:#eee7f4;
}
QFrame#outerFrame {
 border-image:url(:/sw-ui/outer-frame) 42 42 42 42 stretch stretch;
 background:#030207;
}
QFrame#topBar {
 background:rgba(5,3,9,238);
 border:none;
}
QFrame#recentPanel, QFrame#startPanel {
 border-image:url(:/sw-ui/panel-frame) 24 24 24 24 stretch stretch;
 background:rgba(3,3,7,232);
}
QFrame#heroPanel {
 background:qradialgradient(cx:.5,cy:.48,radius:.85,fx:.5,fy:.45,stop:0 #1c0c30,stop:.42 #0c0715,stop:1 #030207);
 border-left:1px solid #514057;
 border-right:1px solid #514057;
}
QFrame#titleCrest {
 background-image:url(:/sw-ui/title-ornament);
 background-position:center;
 background-repeat:no-repeat;
 border:none;
}
QLabel#panelTitle {
 color:#d57cf6;
 font-family:"Times New Roman";
 font-size:25px;
 font-weight:600;
 letter-spacing:1px;
}
QLabel#panelOrnament {
 color:#8a529d;
 font-size:14px;
}
QListWidget#listView { background:transparent; border:none; outline:0; padding:0; }
QListWidget#listView::item {
 background:qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 rgba(17,15,23,245),stop:1 rgba(5,5,8,245));
 border:1px solid #4d4052; margin:5px 1px; padding:0;
}
QListWidget#listView::item:hover { background:#181021; border-color:#8c56a1; }
QListWidget#listView::item:selected { background:#21122f; border-color:#bd6de0; }
QPushButton#actionButton, QPushButton#disabledActionButton {
 border-image:url(:/sw-ui/action-frame) 14 18 14 18 stretch stretch;
 background:rgba(7,6,10,225);
 text-align:left;
 padding-left:38px;
 color:#d994f5;
 font-family:"Times New Roman";
 font-size:18px;
 font-weight:600;
}
QPushButton#actionButton:hover { background:rgba(30,15,43,235); color:#f2d7ff; }
QPushButton#disabledActionButton:disabled { color:#76677c; background:rgba(7,6,10,210); }
QPushButton#button_open_project_folder {
 border-image:url(:/sw-ui/action-frame) 14 18 14 18 stretch stretch;
 background:#09070d; color:#d58cf1; font-family:"Times New Roman"; font-size:17px; font-weight:600;
}
QPushButton#button_open_project_folder:hover { background:#1b1026; color:#f0d2ff; }
QToolButton#settings_button, QToolButton#changelog_button { background:transparent; border:none; color:#cb76ef; font-size:26px; }
QToolButton#settings_button:hover, QToolButton#changelog_button:hover { color:#f0c7ff; background:#160d20; }
QPushButton#button_exit_project { background:#08060c; color:#ccbcd3; border:1px solid #55415d; padding:7px 18px; font-family:"Times New Roman"; font-size:14px; }
QPushButton#button_exit_project:hover { background:#1a1022; border-color:#a967bd; color:white; }
QLabel#footerCenter { color:#bb73d3; font-family:"Times New Roman"; font-size:15px; letter-spacing:1px; }
</string></property>
